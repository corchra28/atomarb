# Copy to .env — read-only RPC/WSS endpoints only. No private keys are ever read by this project.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
# Public key used ONLY as simulation identity (fee payer) with sigVerify=false. No secret key exists in this project.
SIM_IDENTITY_PUBKEY=
